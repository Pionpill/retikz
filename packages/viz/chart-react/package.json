{
  "name": "@retikz/chart-react",
  "version": "0.1.0-alpha.1",
  "private": true,
  "retikz": {
    "domain": "viz",
    "layer": "adapter",
    "publishable": false
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/chart": "workspace:*",
    "@retikz/core": "workspace:^",
    "@retikz/data": "workspace:^",
    "@retikz/layout": "workspace:^",
    "@retikz/plot": "workspace:^",
    "@retikz/plot-react": "workspace:^",
    "@retikz/react": "workspace:^",
    "@retikz/standard": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
