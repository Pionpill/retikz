{
  "name": "@retikz/chart-vanilla",
  "version": "0.1.0-alpha.1",
  "retikz": {
    "domain": "viz",
    "layer": "adapter",
    "publishable": true,
    "releaseGroup": "chart"
  },
  "description": "Plain authoring, SSR, and runtime bindings for @retikz/chart.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": "Pionpill",
  "homepage": "https://pionpill.github.io/retikz/",
  "keywords": [
    "tikz",
    "chart",
    "plot",
    "ssr",
    "visualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pionpill/retikz.git",
    "directory": "packages/viz/chart-vanilla"
  },
  "bugs": {
    "url": "https://github.com/Pionpill/retikz/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./point": {
      "types": "./src/point/index.ts",
      "default": "./src/point/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./point": {
        "types": "./dist/types/point/index.d.ts",
        "import": "./dist/point/index.js",
        "default": "./dist/point/index.js"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/chart": "workspace:*",
    "@retikz/core": "workspace:^",
    "@retikz/data": "workspace:^",
    "@retikz/foundation": "workspace:^",
    "@retikz/layout": "workspace:^",
    "@retikz/plot": "workspace:^",
    "@retikz/plot-vanilla": "workspace:^",
    "@retikz/standard": "workspace:^",
    "@retikz/vanilla": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
