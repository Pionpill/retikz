{
  "name": "@retikz/standard-react",
  "version": "0.1.0-alpha.6",
  "retikz": {
    "domain": "library",
    "releaseGroup": "standard",
    "layer": "adapter",
    "publishable": true
  },
  "description": "React authoring bindings for retikz Standard drawing composites.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Pionpill",
  "homepage": "https://pionpill.github.io/retikz/",
  "keywords": [
    "tikz",
    "diagram",
    "react",
    "standard-drawing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pionpill/retikz.git",
    "directory": "packages/library/standard-react"
  },
  "bugs": {
    "url": "https://github.com/Pionpill/retikz/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shape": {
      "types": "./src/shape/index.ts",
      "default": "./src/shape/index.ts"
    },
    "./presentation": {
      "types": "./src/presentation/index.ts",
      "default": "./src/presentation/index.ts"
    },
    "./container": {
      "types": "./src/container/index.ts",
      "default": "./src/container/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./shape": {
        "types": "./dist/types/shape/index.d.ts",
        "import": "./dist/shape/index.js",
        "default": "./dist/shape/index.js"
      },
      "./presentation": {
        "types": "./dist/types/presentation/index.d.ts",
        "import": "./dist/presentation/index.js",
        "default": "./dist/presentation/index.js"
      },
      "./container": {
        "types": "./dist/types/container/index.d.ts",
        "import": "./dist/container/index.js",
        "default": "./dist/container/index.js"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "oxlint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@retikz/react": "workspace:^",
    "@retikz/standard": "workspace:*",
    "@retikz/standard-vanilla": "workspace:*",
    "@retikz/vanilla": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "@retikz/extension": "workspace:^"
  }
}
