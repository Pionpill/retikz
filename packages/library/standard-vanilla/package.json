{
  "name": "@retikz/standard-vanilla",
  "version": "0.1.0-alpha.1",
  "retikz": {
    "domain": "library",
    "releaseGroup": "standard",
    "layer": "adapter",
    "publishable": true
  },
  "description": "Framework-free authoring bindings for retikz Standard drawing composites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/standard": "workspace:*",
    "@retikz/vanilla": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
