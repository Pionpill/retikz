{
  "name": "@retikz/tex",
  "version": "0.5.0-alpha.2",
  "retikz": {
    "domain": "kernel",
    "releaseGroup": "kernel",
    "layer": "extension",
    "publishable": true
  },
  "description": "retikz tex: LaTeX math via MathJax SVG, lowered to renderer-agnostic glyph paths for @retikz/core.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": "Pionpill",
  "homepage": "https://pionpill.github.io/retikz/",
  "keywords": [
    "tikz",
    "latex",
    "math",
    "mathjax",
    "svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pionpill/retikz.git",
    "directory": "packages/kernel/tex"
  },
  "bugs": {
    "url": "https://github.com/Pionpill/retikz/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/types/react/index.d.ts",
        "import": "./dist/react/index.js",
        "default": "./dist/react/index.js"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/core": "workspace:*"
  },
  "peerDependencies": {
    "mathjax-full": "catalog:",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "mathjax-full": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "mathjax-full": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
