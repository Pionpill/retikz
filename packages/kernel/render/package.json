{
  "name": "@retikz/render",
  "version": "0.5.0-alpha.2",
  "retikz": {
    "domain": "kernel",
    "releaseGroup": "kernel",
    "layer": "renderer",
    "publishable": true
  },
  "description": "retikz rendering backends and shared hydration, animation, and retained runtime contracts, exposed through explicit subpaths.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": "Pionpill",
  "homepage": "https://pionpill.github.io/retikz/",
  "keywords": [
    "tikz",
    "diagram",
    "svg",
    "canvas",
    "renderer",
    "visualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pionpill/retikz.git",
    "directory": "packages/kernel/render"
  },
  "bugs": {
    "url": "https://github.com/Pionpill/retikz/issues"
  },
  "sideEffects": false,
  "exports": {
    "./svg": {
      "types": "./src/svg/index.ts",
      "default": "./src/svg/index.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    },
    "./canvas-node": {
      "types": "./src/canvas-node/index.ts",
      "default": "./src/canvas-node/index.ts"
    },
    "./hydration": {
      "types": "./src/hydration/index.ts",
      "default": "./src/hydration/index.ts"
    },
    "./animation": {
      "types": "./src/animation/index.ts",
      "default": "./src/animation/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./svg": {
        "types": "./dist/types/svg/index.d.ts",
        "import": "./dist/svg/index.js",
        "default": "./dist/svg/index.js"
      },
      "./canvas": {
        "types": "./dist/types/canvas/index.d.ts",
        "import": "./dist/canvas/index.js",
        "default": "./dist/canvas/index.js"
      },
      "./canvas-node": {
        "types": "./dist/types/canvas-node/index.d.ts",
        "import": "./dist/canvas-node/index.js",
        "default": "./dist/canvas-node/index.js"
      },
      "./hydration": {
        "types": "./dist/types/hydration/index.d.ts",
        "import": "./dist/hydration/index.js",
        "default": "./dist/hydration/index.js"
      },
      "./animation": {
        "types": "./dist/types/animation/index.d.ts",
        "import": "./dist/animation/index.js",
        "default": "./dist/animation/index.js"
      },
      "./runtime": {
        "types": "./dist/types/runtime/index.d.ts",
        "import": "./dist/runtime/index.js",
        "default": "./dist/runtime/index.js"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/core": "workspace:*",
    "@retikz/foundation": "workspace:*",
    "@retikz/math": "workspace:*",
    "@retikz/runtime": "workspace:*",
    "csstype": "catalog:"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "catalog:"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
