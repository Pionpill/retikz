{
  "name": "@retikz/bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "retikz deterministic work and wall-clock benchmark harness.",
  "scripts": {
    "bench:check": "tsx src/benchmark/cli.ts check",
    "bench:report": "tsx src/benchmark/cli.ts report",
    "bench:update-baseline": "tsx src/benchmark/cli.ts update-baseline",
    "bench:install-browser": "playwright install chromium",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "@retikz/core": "workspace:*",
    "@retikz/plot-react": "workspace:*",
    "@retikz/render": "workspace:*",
    "@retikz/runtime": "workspace:*",
    "@retikz/vanilla": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
