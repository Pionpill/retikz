{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "lint": "eslint . --cache",
    "lint:kernel": "pnpm --filter @retikz/math --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec eslint .",
    "lint:graph": "pnpm --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla -r exec eslint .",
    "lint:apps": "pnpm --filter @retikz/docs --filter @retikz/eval -r exec eslint .",
    "typecheck": "pnpm run typecheck:full",
    "typecheck:full": "pnpm -r exec tsc --noEmit",
    "typecheck:kernel": "pnpm --filter @retikz/math --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec tsc --noEmit",
    "typecheck:graph": "pnpm --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla -r exec tsc --noEmit",
    "typecheck:apps": "pnpm --filter @retikz/docs --filter @retikz/eval -r exec tsc --noEmit",
    "check": "pnpm run check:full",
    "check:full": "pnpm run lint && pnpm run typecheck:full",
    "check:kernel": "pnpm run lint:kernel && pnpm run typecheck:kernel",
    "check:graph": "pnpm run lint:graph && pnpm run typecheck:graph",
    "check:apps": "pnpm run lint:apps && pnpm run typecheck:apps",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm run test:full",
    "test:full": "pnpm -r --if-present run test:run",
    "test:kernel": "pnpm --filter @retikz/math --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r --if-present run test:run",
    "test:graph": "pnpm --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla -r --if-present run test:run",
    "test:apps": "pnpm --filter @retikz/docs --filter @retikz/eval -r --if-present run test:run",
    "test:docs": "pnpm --filter @retikz/docs test:run",
    "test:eval": "pnpm --filter @retikz/eval test:run",
    "coverage": "pnpm run coverage:full",
    "coverage:full": "pnpm -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:kernel": "pnpm --filter @retikz/math --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:graph": "pnpm --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:apps": "pnpm --filter @retikz/docs --filter @retikz/eval -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:docs": "pnpm --filter @retikz/docs exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:eval": "pnpm --filter @retikz/eval exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "dev:docs": "pnpm --filter @retikz/docs dev"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
