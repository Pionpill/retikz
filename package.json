{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "lint": "eslint . --cache",
    "lint:kernel": "pnpm --filter @retikz/math --filter @retikz/runtime --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec eslint .",
    "lint:viz": "pnpm --filter @retikz/data --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla --filter @retikz/table --filter @retikz/table-react --filter @retikz/table-vanilla -r exec eslint .",
    "lint:apps": "pnpm --filter @retikz/docs --filter @retikz/eval --filter @retikz/bench -r exec eslint .",
    "typecheck": "pnpm run typecheck:full",
    "typecheck:full": "pnpm -r exec tsc --noEmit",
    "typecheck:kernel": "pnpm --filter @retikz/math --filter @retikz/runtime --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec tsc --noEmit",
    "typecheck:viz": "pnpm --filter @retikz/data --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla --filter @retikz/table --filter @retikz/table-react --filter @retikz/table-vanilla -r exec tsc --noEmit",
    "typecheck:apps": "pnpm --filter @retikz/docs --filter @retikz/eval --filter @retikz/bench -r exec tsc --noEmit",
    "check": "pnpm run check:full",
    "check:full": "pnpm run lint && pnpm run typecheck:full && pnpm run check:release-groups && pnpm run check:deprecations",
    "check:kernel": "pnpm run lint:kernel && pnpm run typecheck:kernel",
    "check:viz": "pnpm run lint:viz && pnpm run typecheck:viz",
    "check:apps": "pnpm run lint:apps && pnpm run typecheck:apps",
    "check:release-groups": "node scripts/check-release-groups.mjs",
    "check:deprecations": "node scripts/check-deprecations.mjs",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm run test:full",
    "test:full": "pnpm -r --if-present run test:run && pnpm run test:release-groups && pnpm run test:publish-artifacts:unit && pnpm run test:temp:unit",
    "test:release-groups": "node scripts/check-release-groups.test.mjs",
    "test:publish-artifacts:unit": "node --test scripts/check-publish-artifacts.test.mjs",
    "temp:test": "node scripts/run-temp-test.mjs",
    "test:temp:unit": "node --test scripts/run-temp-test.test.mjs",
    "test:publish-artifacts": "node scripts/check-publish-artifacts.mjs",
    "bench:check": "pnpm --filter @retikz/bench bench:check",
    "bench:report": "pnpm --filter @retikz/bench bench:report",
    "bench:update-baseline": "pnpm --filter @retikz/bench bench:update-baseline",
    "bench:install-browser": "pnpm --filter @retikz/bench bench:install-browser",
    "bench:browser": "pnpm --filter @retikz/bench dev",
    "update:publish-artifact-limits": "node scripts/check-publish-artifacts.mjs --update-limits",
    "test:kernel": "pnpm --filter @retikz/math --filter @retikz/runtime --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r --if-present run test:run",
    "test:viz": "pnpm --filter @retikz/data --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla --filter @retikz/table --filter @retikz/table-react --filter @retikz/table-vanilla -r --if-present run test:run",
    "test:apps": "pnpm --filter @retikz/docs --filter @retikz/eval --filter @retikz/bench -r --if-present run test:run",
    "test:docs": "pnpm --filter @retikz/docs test:run",
    "test:eval": "pnpm --filter @retikz/eval test:run",
    "coverage": "pnpm run coverage:full",
    "coverage:full": "pnpm -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:kernel": "pnpm --filter @retikz/math --filter @retikz/runtime --filter @retikz/core --filter @retikz/render --filter @retikz/react --filter @retikz/vanilla --filter @retikz/tex -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:viz": "pnpm --filter @retikz/data --filter @retikz/plot --filter @retikz/plot-react --filter @retikz/plot-vanilla --filter @retikz/table --filter @retikz/table-react --filter @retikz/table-vanilla -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:apps": "pnpm --filter @retikz/docs --filter @retikz/eval --filter @retikz/bench -r exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:docs": "pnpm --filter @retikz/docs exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "coverage:eval": "pnpm --filter @retikz/eval exec vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "dev:docs": "pnpm --filter @retikz/docs dev"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
